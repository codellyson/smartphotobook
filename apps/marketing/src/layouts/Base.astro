---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "SmartPhotobook — a local-first photobook designer",
  description = "Lay out your photobook on a real spread canvas. Drag, crop, frame, and export a press-ready PDF — your photos never leave your machine.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#16151a" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --accent: #c98a5e;
    --ink: #ece6dc;
    --ink-dim: #c8c0b4;
    --bg: #16151a;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }
  a { color: inherit; }
</style>
